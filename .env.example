# Copie estas variaveis para: Vercel > Project > Settings > Environment Variables
# (nunca commite valores reais)

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
SUPABASE_BUCKET=uploads

# Senha inicial do painel /admin (usuario: admin). Defina uma senha forte!
ADMIN_PASSWORD=troque-esta-senha

# Gateway Payberry (opcional: tambem pode ser configurado em /admin/gateway.php)
PAYBERRY_PUBLIC_KEY=
PAYBERRY_SECRET_KEY=
